      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">DayNightCycle</string>
          <string name="Source"><![CDATA[-- DayNightCycle.luau
-- Handles day/night cycle with smooth transitions

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage.Forthy.Config)

local DayNightCycle = {}

local running = false
local currentTime = 0  -- In hours (0-24)

-- Get time period (dawn, day, dusk, night)
local function getTimePeriod(hour)
	if hour >= 5 and hour < 7 then
		return "dawn"
	elseif hour >= 7 and hour < 18 then
		return "day"
	elseif hour >= 18 and hour < 20 then
		return "dusk"
	else
		return "night"
	end
end

-- Get brightness multiplier for current time
local function getBrightnessMultiplier(hour)
	local cycle = Config.DAY_NIGHT_CYCLE
	local period = getTimePeriod(hour)

	if period == "dawn" then
		-- Transition from night to day (5:00 - 7:00)
		local t = (hour - 5) / 2  -- 0 to 1
		return cycle.NIGHT_BRIGHTNESS + t * (cycle.DAY_BRIGHTNESS - cycle.NIGHT_BRIGHTNESS)
	elseif period == "day" then
		return cycle.DAY_BRIGHTNESS
	elseif period == "dusk" then
		-- Transition from day to night (18:00 - 20:00)
		local t = (hour - 18) / 2  -- 0 to 1
		return cycle.DAY_BRIGHTNESS + t * (cycle.NIGHT_BRIGHTNESS - cycle.DAY_BRIGHTNESS)
	else
		return cycle.NIGHT_BRIGHTNESS
	end
end

-- Get ambient color for current time
local function getAmbientColor(hour)
	local cycle = Config.DAY_NIGHT_CYCLE
	local period = getTimePeriod(hour)

	if period == "dawn" then
		local t = (hour - 5) / 2
		return cycle.NIGHT_AMBIENT:Lerp(cycle.DAY_AMBIENT, t)
	elseif period == "day" then
		return cycle.DAY_AMBIENT
	elseif period == "dusk" then
		local t = (hour - 18) / 2
		return cycle.DAY_AMBIENT:Lerp(cycle.NIGHT_AMBIENT, t)
	else
		return cycle.NIGHT_AMBIENT
	end
end

-- Update lighting based on current time
local function updateLighting()
	local lightConfig = Config.LIGHTING
	local brightnessMultiplier = getBrightnessMultiplier(currentTime)
	local ambientColor = getAmbientColor(currentTime)

	Lighting.ClockTime = currentTime
	Lighting.Brightness = lightConfig.BRIGHTNESS * brightnessMultiplier
	Lighting.Ambient = ambientColor
	Lighting.OutdoorAmbient = ambientColor

	-- Adjust fog based on time (denser at night)
	local fogMultiplier = 1 + (1 - brightnessMultiplier) * 0.5  -- Fog gets denser at night
	Lighting.FogEnd = lightConfig.FOG_END / fogMultiplier
end

function DayNightCycle.start()
	if running then return end

	local cycle = Config.DAY_NIGHT_CYCLE
	if not cycle.ENABLED then
		print("DayNightCycle: Disabled in config")
		return
	end

	running = true
	currentTime = Config.LIGHTING.START_TIME

	print("DayNightCycle: Started at " .. string.format("%02d:00", math.floor(currentTime)))

	task.spawn(function()
		local lastUpdate = tick()

		while running do
			local now = tick()
			local delta = now - lastUpdate
			lastUpdate = now

			-- Advance time
			-- SECONDS_PER_HOUR real seconds = 1 in-game hour
			local hoursPerSecond = 1 / cycle.SECONDS_PER_HOUR
			currentTime = currentTime + delta * hoursPerSecond

			-- Wrap around at 24
			if currentTime >= 24 then
				currentTime = currentTime - 24
			end

			-- Update lighting
			updateLighting()

			task.wait(0.1)  -- Update 10 times per second for smooth transitions
		end
	end)
end

function DayNightCycle.getTimeString()
	local hours = math.floor(currentTime)
	local minutes = math.floor((currentTime - hours) * 60)
	return string.format("%02d:%02d", hours, minutes)
end

return DayNightCycle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">EnemyManager</string>
          <string name="Source"><![CDATA[-- EnemyManager.luau
-- Simplified enemy system for Tower Defense
-- Enemies are DUMB - they just walk to the Core
-- No interpreter, no complex AI - just pathfinding to target

local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EnemyManager = {}

local enemies = {}
local deps = nil
local WaveManager = nil

-- Spatial partitioning grid for optimized enemy lookups
local GRID_CELL_SIZE = 20  -- studs per grid cell
local enemyGrid = {}       -- Key: "gx_gz", Value: table of enemy references

-- Base enemy type definitions (these get scaled per wave)
-- Buffed for "Action Strategy" - more HP, more scrap, faster pace
local EnemyTypes = {
	Zombie = {
		name = "Zombie",
		modelName = "Zombie",
		hp = 50,          -- Slight buff (was 40)
		speed = 7,        -- Faster! (was 6)
		damage = 10,      -- Damage to Core (was 8)
		scrap = 15,       -- HUGE BUFF (was 5). Pays for 300 bullets!
		size = 1,
	},
	Runner = {
		name = "Runner",
		modelName = "Runner",
		hp = 30,          -- Slight buff (was 25)
		speed = 14,       -- Zoom (was 12)
		damage = 5,
		scrap = 10,       -- Buff (was 3)
		size = 0.8,
	},
	Tank = {
		name = "Tank",
		modelName = "Tank",
		hp = 400,         -- Tankier (was 150)
		speed = 4,
		damage = 30,      -- Was 25
		scrap = 100,      -- Loot pinata (was 15)
		size = 1.5,
	},
	Boss = {
		name = "Boss",
		modelName = "Boss",
		hp = 1000,        -- Was 800
		speed = 5,
		damage = 100,     -- Was 80
		scrap = 250,      -- Big payday (was 100)
		size = 2.5,
	},
}

-- Wave scaling configuration
local WaveScaling = {
	hpPerWave = 0.15,      -- +15% HP per wave
	damagePerWave = 0.10,  -- +10% damage per wave
	sizePerWave = 0.03,    -- +3% size per wave
	speedPerWave = 0.02,   -- +2% speed per wave (capped)
	maxSpeedMult = 1.5,    -- Max speed multiplier
}

-- Current wave (set by WaveManager)
local currentWave = 1
local newGamePlusMultiplier = 1  -- Doubles after all 8 gates unlocked

-- Spawn gates (set from map)
local spawnGates = {}

--============================================================================
-- INITIALIZATION
--============================================================================

function EnemyManager.init(dependencies)
	deps = dependencies
	print("EnemyManager: Initialized")
end

function EnemyManager.setWaveManager(waveMgr)
	WaveManager = waveMgr
end

function EnemyManager.setSpawnGates(gates)
	spawnGates = gates
	print("EnemyManager: Set", #gates, "spawn gates")
end

function EnemyManager.setWave(wave)
	currentWave = wave
end

function EnemyManager.setNewGamePlusMultiplier(mult)
	newGamePlusMultiplier = mult
	print("EnemyManager: NG+ multiplier set to", mult)
end

-- Calculate scaled stats for current wave
local function getScaledStats(enemyType)
	local base = EnemyTypes[enemyType]
	if not base then return nil end

	local waveMult = 1 + (currentWave - 1) * WaveScaling.hpPerWave
	local damageMult = 1 + (currentWave - 1) * WaveScaling.damagePerWave
	local sizeMult = 1 + (currentWave - 1) * WaveScaling.sizePerWave
	local speedMult = math.min(WaveScaling.maxSpeedMult, 1 + (currentWave - 1) * WaveScaling.speedPerWave)

	return {
		name = base.name,
		modelName = base.modelName,
		hp = math.floor(base.hp * waveMult * newGamePlusMultiplier),
		speed = base.speed * speedMult,
		damage = math.floor(base.damage * damageMult * newGamePlusMultiplier),
		scrap = math.floor(base.scrap * (1 + (currentWave - 1) * 0.1)),  -- Scrap also scales
		size = base.size * sizeMult,
	}
end

--============================================================================
-- HELPERS
--============================================================================

local function getEnemyModelsFolder()
	return ServerStorage:FindFirstChild("Enemies") or ServerStorage:FindFirstChild("Monsters")
end

local function findModelInFolder(folder)
	local model = folder:FindFirstChild("Model")
	if model and model:IsA("Model") then return model end

	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("Model") and child:FindFirstChild("HumanoidRootPart") then
			return child
		end
	end

	if folder:FindFirstChild("HumanoidRootPart") then return folder end
	return nil
end

local function createSimpleEnemy(typeName, position, scaledType)
	-- Use scaled stats if provided, otherwise get base type
	local enemyType = scaledType or EnemyTypes[typeName]
	if not enemyType then
		warn("EnemyManager: Unknown enemy type:", typeName)
		return nil
	end

	local modelsFolder = getEnemyModelsFolder()
	local character = nil

	if modelsFolder then
		local modelFolder = modelsFolder:FindFirstChild(enemyType.modelName)
		if modelFolder then
			local sourceModel = findModelInFolder(modelFolder)
			if sourceModel then
				character = sourceModel:Clone()
			end
		end
	end

	-- Fallback: create simple part if no model
	if not character then
		character = Instance.new("Model")
		character.Name = typeName

		local hrp = Instance.new("Part")
		hrp.Name = "HumanoidRootPart"
		hrp.Size = Vector3.new(2, 4, 2) * enemyType.size
		hrp.Position = position
		hrp.Anchored = true
		hrp.CanCollide = false
		hrp.Material = Enum.Material.SmoothPlastic

		-- Color by type
		if typeName == "Zombie" then
			hrp.Color = Color3.fromRGB(100, 150, 100)
		elseif typeName == "Runner" then
			hrp.Color = Color3.fromRGB(150, 100, 150)
		elseif typeName == "Tank" then
			hrp.Color = Color3.fromRGB(100, 100, 150)
		elseif typeName == "Boss" then
			hrp.Color = Color3.fromRGB(200, 50, 50)
		end

		hrp.Parent = character
		character.PrimaryPart = hrp
	end

	return character
end

--============================================================================
-- SPAWNING
--============================================================================

function EnemyManager.spawn(typeName, gateIndex, dependencies)
	local gate = spawnGates[gateIndex]
	if not gate then
		warn("EnemyManager: Invalid gate index:", gateIndex)
		-- Fallback to first gate
		gate = spawnGates[1]
		if not gate then return nil end
	end

	-- Get scaled stats for current wave
	local enemyType = getScaledStats(typeName)
	if not enemyType then
		warn("EnemyManager: Unknown enemy type:", typeName)
		return nil
	end

	-- Randomize spawn position slightly
	local spawnX = gate.x + (math.random() - 0.5) * 6
	local spawnZ = gate.z + (math.random() - 0.5) * 6
	local spawnPos = Vector3.new(spawnX, 3, spawnZ)

	local character = createSimpleEnemy(typeName, spawnPos, enemyType)
	if not character then return nil end

	-- Position the model
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp then
		character:PivotTo(CFrame.new(spawnPos))
	end

	-- Anchor all parts
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
		end
	end

	character.Parent = workspace

	-- Create enemy data
	local id = game:GetService("HttpService"):GenerateGUID()
	local enemy = {
		id = id,
		character = character,
		typeData = enemyType,
		hp = enemyType.hp,
		maxHp = enemyType.hp,
		speed = enemyType.speed,
		damage = enemyType.damage,
		scrap = enemyType.scrap,

		-- Movement
		targetPos = nil,      -- Will be set to Core position
		velocityX = 0,
		velocityZ = 0,

		-- Animation
		time = math.random() * 10,
		baseY = 3,
	}

	enemies[id] = enemy

	-- Register with EntityRegistry for targeting
	if deps.EntityRegistry then
		deps.EntityRegistry.register({
			id = id,
			isEnemy = true,
			isMonster = true,  -- For compatibility with existing targeting code
			character = character,
			hp = enemy.hp,
			maxHp = enemy.maxHp,
		})
	end

	-- Create HP bar billboard
	EnemyManager.createHpBar(enemy)

	return id
end

--============================================================================
-- HP BAR BILLBOARD
--============================================================================

function EnemyManager.createHpBar(enemy)
	local character = enemy.character
	local hrp = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
	if not hrp then return end

	-- Billboard GUI
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "EnemyHpBar"
	billboard.Size = UDim2.new(0, 60, 0, 10)
	billboard.StudsOffset = Vector3.new(0, 3 * (enemy.typeData.size or 1), 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 50
	billboard.Parent = hrp

	-- Background bar
	local bgBar = Instance.new("Frame")
	bgBar.Name = "Background"
	bgBar.Size = UDim2.new(1, 0, 1, 0)
	bgBar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	bgBar.BorderSizePixel = 0
	bgBar.Parent = billboard

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(0, 3)
	bgCorner.Parent = bgBar

	-- HP fill bar
	local hpBar = Instance.new("Frame")
	hpBar.Name = "HpBar"
	hpBar.Size = UDim2.new(1, 0, 1, 0)
	hpBar.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
	hpBar.BorderSizePixel = 0
	hpBar.Parent = bgBar

	local hpCorner = Instance.new("UICorner")
	hpCorner.CornerRadius = UDim.new(0, 3)
	hpCorner.Parent = hpBar

	-- Enemy name label (small, above bar)
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.new(1, 0, 0, 12)
	nameLabel.Position = UDim2.new(0, 0, 0, -14)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = enemy.typeData.name or "Enemy"
	nameLabel.TextColor3 = Color3.fromRGB(255, 150, 150)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 10
	nameLabel.TextStrokeTransparency = 0.5
	nameLabel.Parent = billboard

	enemy.hpBillboard = billboard
end

function EnemyManager.updateHpBar(enemy)
	if not enemy.hpBillboard then return end

	local bgBar = enemy.hpBillboard:FindFirstChild("Background")
	if not bgBar then return end

	local hpBar = bgBar:FindFirstChild("HpBar")
	if not hpBar then return end

	local ratio = math.max(0, enemy.hp / enemy.maxHp)
	hpBar.Size = UDim2.new(ratio, 0, 1, 0)

	-- Color based on HP percentage
	if ratio > 0.5 then
		hpBar.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
	elseif ratio > 0.25 then
		hpBar.BackgroundColor3 = Color3.fromRGB(255, 150, 50)
	else
		hpBar.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
	end
end

--============================================================================
-- DAMAGE
--============================================================================

function EnemyManager.damage(enemyId, amount, sourceGolemId)
	local enemy = enemies[enemyId]
	if not enemy then return false end

	enemy.hp = enemy.hp - amount

	-- Update EntityRegistry
	if deps.EntityRegistry then
		local entity = deps.EntityRegistry.get(enemyId)
		if entity then
			entity.hp = enemy.hp
		end
	end

	-- Update HP bar
	EnemyManager.updateHpBar(enemy)

	-- Damage number visual
	if enemy.character then
		local hrp = enemy.character:FindFirstChild("HumanoidRootPart")
		if hrp and deps.attackHitEvent then
			for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
				deps.attackHitEvent:FireClient(player, {
					targetPos = hrp.Position,
					damage = amount,
					hitCount = 1,
				})
			end
		end
	end

	if enemy.hp <= 0 then
		EnemyManager.kill(enemyId, sourceGolemId)
		return true
	end

	return false
end

function EnemyManager.applySlow(enemyId, slowAmount, duration)
	local enemy = enemies[enemyId]
	if not enemy then return end

	-- Apply slow effect (stacks refresh duration, doesn't stack intensity)
	enemy.slowAmount = slowAmount
	enemy.slowExpires = tick() + duration

	-- Visual indicator - tint the enemy blue
	if enemy.character then
		for _, part in ipairs(enemy.character:GetDescendants()) do
			if part:IsA("BasePart") and not part:GetAttribute("OriginalColor") then
				part:SetAttribute("OriginalColor", part.Color:ToHex())
			end
			if part:IsA("BasePart") then
				-- Blend toward ice blue
				local origHex = part:GetAttribute("OriginalColor")
				if origHex then
					local orig = Color3.fromHex(origHex)
					part.Color = orig:Lerp(Color3.fromRGB(100, 200, 255), 0.5)
				end
			end
		end
	end
end

function EnemyManager.clearSlow(enemy)
	enemy.slowAmount = nil
	enemy.slowExpires = nil

	-- Restore original colors
	if enemy.character then
		for _, part in ipairs(enemy.character:GetDescendants()) do
			if part:IsA("BasePart") then
				local origHex = part:GetAttribute("OriginalColor")
				if origHex then
					part.Color = Color3.fromHex(origHex)
				end
			end
		end
	end
end

function EnemyManager.kill(enemyId, killerGolemId)
	local enemy = enemies[enemyId]
	if not enemy then return end

	-- Death effect
	if enemy.character then
		local hrp = enemy.character:FindFirstChild("HumanoidRootPart")
		if hrp then
			-- Quick shrink animation
			task.spawn(function()
				for i = 1, 10 do
					if enemy.character and enemy.character.Parent then
						local scale = 1 - (i / 10)
						enemy.character:ScaleTo(math.max(0.1, scale))
					end
					task.wait(0.03)
				end
				if enemy.character then
					enemy.character:Destroy()
				end
			end)
		end
	end

	-- Unregister
	if deps.EntityRegistry then
		deps.EntityRegistry.unregister(enemyId)
	end

	-- Notify WaveManager
	if WaveManager then
		WaveManager.onEnemyKilled(enemyId, killerGolemId)
	end

	enemies[enemyId] = nil
end

--============================================================================
-- SPATIAL PARTITIONING (Grid-based enemy lookups)
--============================================================================

-- Convert world position to grid key
local function getGridKey(x, z)
	local gx = math.floor(x / GRID_CELL_SIZE)
	local gz = math.floor(z / GRID_CELL_SIZE)
	return gx .. "_" .. gz
end

-- Rebuild the spatial grid from current enemy positions
-- Called once per frame in update loop
local function rebuildGrid()
	table.clear(enemyGrid)

	for id, enemy in pairs(enemies) do
		if enemy.hp > 0 and enemy.character then
			local hrp = enemy.character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local pos = hrp.Position
				local key = getGridKey(pos.X, pos.Z)
				if not enemyGrid[key] then
					enemyGrid[key] = {}
				end
				table.insert(enemyGrid[key], enemy)
			end
		end
	end
end

-- Get all grid cells that could contain enemies within range of (x, z)
-- Returns enemies in those cells
local function getEnemiesNearPoint(x, z, range)
	local cellsToCheck = math.ceil(range / GRID_CELL_SIZE)
	local gx = math.floor(x / GRID_CELL_SIZE)
	local gz = math.floor(z / GRID_CELL_SIZE)

	local results = {}

	for i = -cellsToCheck, cellsToCheck do
		for j = -cellsToCheck, cellsToCheck do
			local key = (gx + i) .. "_" .. (gz + j)
			local cell = enemyGrid[key]
			if cell then
				for _, enemy in ipairs(cell) do
					table.insert(results, enemy)
				end
			end
		end
	end

	return results
end

--============================================================================
-- UPDATE LOOP
--============================================================================

function EnemyManager.update(dt)
	if not WaveManager then return end

	local corePos = WaveManager.getCorePosition()
	if not corePos then return end

	-- Rebuild spatial grid for optimized enemy lookups
	rebuildGrid()

	local toRemove = {}

	-- BulkMoveTo optimization: collect all parts and CFrames
	local partList = {}
	local cframeList = {}

	-- Pre-calculate core reach distance squared (avoid sqrt in loop)
	local CORE_REACH_DIST_SQ = 4 * 4  -- 16

	for id, enemy in pairs(enemies) do
		local character = enemy.character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")

		if not hrp then
			table.insert(toRemove, id)
			continue
		end

		-- Already dead?
		if enemy.hp <= 0 then
			continue
		end

		local myX, myZ = hrp.Position.X, hrp.Position.Z
		local targetX, targetZ = corePos.x, corePos.z

		-- Calculate direction to Core
		local dx = targetX - myX
		local dz = targetZ - myZ
		local distSq = dx * dx + dz * dz  -- Squared distance (no sqrt!)

		-- Check if reached Core (use squared comparison)
		if distSq < CORE_REACH_DIST_SQ then
			-- Deal damage to Core
			WaveManager.damageCore(enemy.damage, id)
			WaveManager.onEnemyReachedCore(id)

			-- Remove enemy
			if character then character:Destroy() end
			if deps.EntityRegistry then
				deps.EntityRegistry.unregister(id)
			end
			table.insert(toRemove, id)
			continue
		end

		-- Check/clear slow effect
		if enemy.slowExpires and tick() > enemy.slowExpires then
			EnemyManager.clearSlow(enemy)
		end

		-- Calculate effective speed (apply slow if active)
		local effectiveSpeed = enemy.speed
		if enemy.slowAmount then
			effectiveSpeed = enemy.speed * (1 - enemy.slowAmount)
		end

		-- Move toward Core
		if distSq > 0.01 then  -- 0.1^2 = 0.01
			-- Only compute sqrt when needed for normalization
			local dist = math.sqrt(distSq)
			local dirX = dx / dist
			local dirZ = dz / dist

			-- Smooth velocity
			local targetVelX = dirX * effectiveSpeed
			local targetVelZ = dirZ * effectiveSpeed

			enemy.velocityX = enemy.velocityX + (targetVelX - enemy.velocityX) * 0.1
			enemy.velocityZ = enemy.velocityZ + (targetVelZ - enemy.velocityZ) * 0.1

			local newX = myX + enemy.velocityX * dt
			local newZ = myZ + enemy.velocityZ * dt

			-- Simple bobbing animation
			enemy.time = enemy.time + dt
			local bobAmount = 0.2
			local bobSpeed = enemy.speed * 2
			local bob = math.sin(enemy.time * bobSpeed) * bobAmount
			local newY = enemy.baseY + bob

			-- Update facing direction
			local facingAngle = math.atan2(dx, dz) + math.pi

			-- Queue for BulkMoveTo instead of individual PivotTo
			local newCF = CFrame.new(newX, newY, newZ) * CFrame.Angles(0, facingAngle, 0)
			table.insert(partList, hrp)
			table.insert(cframeList, newCF)
		end
	end

	-- BulkMoveTo: Update all enemy positions in a single physics step
	if #partList > 0 then
		workspace:BulkMoveTo(partList, cframeList, Enum.BulkMoveMode.FireCFrameChanged)
	end

	-- Clean up
	for _, id in ipairs(toRemove) do
		enemies[id] = nil
	end
end

--============================================================================
-- QUERIES
--============================================================================

function EnemyManager.get(id)
	return enemies[id]
end

function EnemyManager.getAll()
	return enemies
end

function EnemyManager.count()
	local n = 0
	for _ in pairs(enemies) do n = n + 1 end
	return n
end

function EnemyManager.findNearest(x, z, maxRange)
	local nearest = nil
	local nearestDistSq = maxRange and (maxRange * maxRange) or math.huge

	-- Use spatial grid for bounded searches, fallback to full scan for unbounded
	local candidates
	if maxRange and maxRange < math.huge then
		candidates = getEnemiesNearPoint(x, z, maxRange)
	else
		-- Unbounded search - must check all enemies
		candidates = {}
		for _, enemy in pairs(enemies) do
			table.insert(candidates, enemy)
		end
	end

	for _, enemy in ipairs(candidates) do
		if enemy.hp > 0 and enemy.character then
			local hrp = enemy.character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local dx = hrp.Position.X - x
				local dz = hrp.Position.Z - z
				local distSq = dx * dx + dz * dz  -- Squared distance (no sqrt!)
				if distSq < nearestDistSq then
					nearestDistSq = distSq
					nearest = enemy
				end
			end
		end
	end

	-- Return actual distance for API compatibility
	return nearest, nearest and math.sqrt(nearestDistSq) or (maxRange or math.huge)
end

function EnemyManager.findWeakest(x, z, maxRange)
	local weakest = nil
	local lowestHp = math.huge
	local effectiveRangeSq = maxRange and (maxRange * maxRange) or math.huge

	-- Use spatial grid for bounded searches
	local candidates
	if maxRange and maxRange < math.huge then
		candidates = getEnemiesNearPoint(x, z, maxRange)
	else
		candidates = {}
		for _, enemy in pairs(enemies) do
			table.insert(candidates, enemy)
		end
	end

	for _, enemy in ipairs(candidates) do
		if enemy.hp > 0 and enemy.character then
			local hrp = enemy.character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local dx = hrp.Position.X - x
				local dz = hrp.Position.Z - z
				local distSq = dx * dx + dz * dz  -- Squared distance (no sqrt!)
				if distSq <= effectiveRangeSq and enemy.hp < lowestHp then
					lowestHp = enemy.hp
					weakest = enemy
				end
			end
		end
	end

	return weakest
end

function EnemyManager.findInRange(x, z, range)
	local inRange = {}
	local candidates = getEnemiesNearPoint(x, z, range)
	local rangeSq = range * range  -- Pre-compute squared range

	for _, enemy in ipairs(candidates) do
		if enemy.hp > 0 and enemy.character then
			local hrp = enemy.character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local dx = hrp.Position.X - x
				local dz = hrp.Position.Z - z
				local distSq = dx * dx + dz * dz  -- Squared distance (no sqrt!)
				if distSq <= rangeSq then
					table.insert(inRange, enemy)
				end
			end
		end
	end

	return inRange
end

function EnemyManager.clear()
	for id, enemy in pairs(enemies) do
		if enemy.character then
			enemy.character:Destroy()
		end
		if deps and deps.EntityRegistry then
			deps.EntityRegistry.unregister(id)
		end
	end
	enemies = {}
	table.clear(enemyGrid)  -- Clear spatial grid
end

--============================================================================
-- INIT HEARTBEAT
--============================================================================

function EnemyManager.startUpdateLoop()
	RunService.Heartbeat:Connect(function(dt)
		EnemyManager.update(dt)
	end)
end

return EnemyManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">GolemRegistry</string>
          <string name="Source"><![CDATA[-- GolemRegistry.luau
-- Manages programmable turrets (Golems) for Tower Defense
-- Each Golem has its own Interpreter running Forth code!

local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GolemRegistry = {}

local golems = {}
local deps = nil
local Interpreter = nil
local WaveManager = nil
local EnemyManager = nil

-- Free placement system
local mapData = nil
local restrictedZones = {}
local golemMinDistance = 8
local nextGolemNumber = 1 -- For generating sequential IDs

-- Single golem type - weapons are determined by ammo used
-- Buffed for "Action Strategy" feel
local GolemStats = {
	name = "Golem",
	modelName = "Turret", -- Use turret model for all
	hp = 200,          -- Was 100. More durable.
	maxAmmo = 300,     -- Was 100. Capacity tripled.
	range = 40,        -- Was 30. See enemies sooner.
	cost = 100,        -- Keep cost low for army building.
}

-- Ammo type stats (damage, cost, fireRate, range bonus, effect)
-- Buffed for "Big Boom" feel - special weapons are viable primary weapons
local AmmoStats = {
	[1] = {                              -- BULLET
		name = "BULLET",
		damage = 15,                     -- Was 10. Machine gun feel.
		ammoCost = 1,
		fireRate = 0.2,                  -- Was 0.3. Shoots faster.
		color = Color3.fromRGB(255, 255, 200), -- Yellow tracer
	},
	[2] = {                              -- ROCKET
		name = "ROCKET",
		damage = 80,                     -- Was 50. Big boom!
		ammoCost = 4,                    -- Was 5. Slightly cheaper.
		fireRate = 1.0,
		splashRadius = 12,               -- Was 8. Bigger BOOM.
		color = Color3.fromRGB(255, 100, 50), -- Orange tracer
	},
	[3] = {                              -- LASER
		name = "LASER",
		damage = 40,                     -- Was 25. Sniper damage.
		ammoCost = 2,
		fireRate = 0.1,                  -- Was 0.5. LASER BEAM (rapid fire).
		color = Color3.fromRGB(255, 50, 50), -- Red beam
	},
	[4] = {                              -- ICE
		name = "ICE",
		damage = 20,                     -- Was 15.
		ammoCost = 2,                    -- Was 3. Cheaper crowd control.
		fireRate = 0.4,                  -- Was 0.6. Faster freeze.
		slowAmount = 0.6,                -- Was 0.5. Reduces speed by 60%
		slowDuration = 4.0,              -- Was 3. 4 seconds freeze.
		color = Color3.fromRGB(100, 200, 255), -- Cyan/ice blue
	},
	[5] = {                              -- FREEZE (Strategic Utility)
		name = "FREEZE",
		damage = 0,                      -- No damage! Pure utility.
		ammoCost = 1,                    -- Cheap
		fireRate = 0.1,                  -- Fast spray
		slowAmount = 0.3,                -- Slows TO 70% speed (30% reduction)
		slowDuration = 3.0,
		color = Color3.fromRGB(0, 255, 255), -- Cyan
	},
}

-- Default program for new golems
local DEFAULT_PROGRAM = [[
: DEFEND
  BEGIN
    SCAN 0 > IF
      NEAREST TARGET
      BULLET FIRE
    THEN
  AGAIN
;
40 SET-RANGE DEFEND
]]

-- Remote events
local golemStateEvent = nil
local golemPlaceAtEvent = nil -- Free placement
local golemSellEvent = nil    -- Sell/delete golem
local golemFullStateEvent = nil
local golemRegisterViewerEvent = nil
local golemUnregisterViewerEvent = nil

-- Viewer management for Golem Mind Mode
local golemViewers = {} -- {golemId -> {player1, player2, ...}}

--============================================================================
-- INITIALIZATION
--============================================================================

function GolemRegistry.init(dependencies, interpreterModule)
	deps = dependencies
	Interpreter = interpreterModule

	-- Create remote events
	local Forthy = ReplicatedStorage:WaitForChild("Forthy")

	golemStateEvent = Instance.new("RemoteEvent")
	golemStateEvent.Name = "GolemState"
	golemStateEvent.Parent = Forthy

	golemPlaceAtEvent = Instance.new("RemoteEvent")
	golemPlaceAtEvent.Name = "GolemPlaceAt"
	golemPlaceAtEvent.Parent = Forthy

	golemSellEvent = Instance.new("RemoteEvent")
	golemSellEvent.Name = "GolemSell"
	golemSellEvent.Parent = Forthy

	golemFullStateEvent = Instance.new("RemoteEvent")
	golemFullStateEvent.Name = "GolemFullState"
	golemFullStateEvent.Parent = Forthy

	golemRegisterViewerEvent = Instance.new("RemoteEvent")
	golemRegisterViewerEvent.Name = "GolemRegisterViewer"
	golemRegisterViewerEvent.Parent = Forthy

	golemUnregisterViewerEvent = Instance.new("RemoteEvent")
	golemUnregisterViewerEvent.Name = "GolemUnregisterViewer"
	golemUnregisterViewerEvent.Parent = Forthy

	-- Handle free placement requests
	golemPlaceAtEvent.OnServerEvent:Connect(function(player, x, z)
		local success, result = GolemRegistry.tryPlaceAt(player, x, z)
		-- Send result back to player
		golemPlaceAtEvent:FireClient(player, success, result)
	end)

	-- Handle sell requests
	golemSellEvent.OnServerEvent:Connect(function(player, golemId)
		local success, result = GolemRegistry.sellGolem(player, golemId)
		golemSellEvent:FireClient(player, success, result)
	end)

	-- Handle viewer registration (Golem Mind Mode)
	golemRegisterViewerEvent.OnServerEvent:Connect(function(player, golemId)
		if not golemViewers[golemId] then
			golemViewers[golemId] = {}
		end
		table.insert(golemViewers[golemId], player)
		print("GolemRegistry: Player", player.Name, "registered as viewer for golem", golemId)
	end)

	-- Handle viewer unregistration
	golemUnregisterViewerEvent.OnServerEvent:Connect(function(player, golemId)
		if golemViewers[golemId] then
			for i, p in ipairs(golemViewers[golemId]) do
				if p == player then
					table.remove(golemViewers[golemId], i)
					print("GolemRegistry: Player", player.Name, "unregistered from golem", golemId)
					break
				end
			end
		end
	end)

	print("GolemRegistry: Initialized")
end

function GolemRegistry.setWaveManager(waveMgr)
	WaveManager = waveMgr
end

-- Expose events for main.server to listen to
function GolemRegistry.getViewerEvents()
	return golemRegisterViewerEvent, golemUnregisterViewerEvent
end

function GolemRegistry.setEnemyManager(enemyMgr)
	EnemyManager = enemyMgr
end

function GolemRegistry.setMapData(map)
	mapData = map
	restrictedZones = map.restrictedZones or {}
	golemMinDistance = map.golemMinDistance or 8
	print("GolemRegistry: Map data loaded with", #restrictedZones, "restricted zones")
end

--============================================================================
-- ZONE VALIDATION (for free placement)
--============================================================================

local function isPointInCircle(px, pz, cx, cz, radius)
	local dx = px - cx
	local dz = pz - cz
	return (dx * dx + dz * dz) <= (radius * radius)
end

local function isPointInRect(px, pz, x1, z1, x2, z2)
	return px >= x1 and px <= x2 and pz >= z1 and pz <= z2
end

local function isPointNearLine(px, pz, x1, z1, x2, z2, width)
	-- Calculate distance from point to line segment
	local dx = x2 - x1
	local dz = z2 - z1
	local len2 = dx * dx + dz * dz

	if len2 == 0 then
		-- Line is a point
		return isPointInCircle(px, pz, x1, z1, width / 2)
	end

	-- Project point onto line
	local t = math.max(0, math.min(1, ((px - x1) * dx + (pz - z1) * dz) / len2))
	local projX = x1 + t * dx
	local projZ = z1 + t * dz

	local distX = px - projX
	local distZ = pz - projZ
	local dist = math.sqrt(distX * distX + distZ * distZ)

	return dist <= (width / 2)
end

function GolemRegistry.isInRestrictedZone(x, z)
	if not mapData then return false end

	local mapWidth = (mapData.width or 50) * 6 -- Assuming 6 studs per cell
	local mapHeight = (mapData.height or 50) * 6

	for _, zone in ipairs(restrictedZones) do
		-- SKIP PATH RESTRICTIONS - enemies walk through turrets, so paths are buildable!
		-- Only block "core" and "boundary" zones
		if zone.reason == "path" then
			continue
		end

		if zone.type == "circle" then
			if isPointInCircle(x, z, zone.x, zone.z, zone.radius) then
				return true, zone.reason
			end
		elseif zone.type == "rect" then
			if isPointInRect(x, z, zone.x1, zone.z1, zone.x2, zone.z2) then
				return true, zone.reason
			end
		elseif zone.type == "line" then
			-- Skip line restrictions (these are typically paths)
			continue
		elseif zone.type == "boundary" then
			local margin = zone.margin or 10
			if x < margin or x > mapWidth - margin or z < margin or z > mapHeight - margin then
				return true, zone.reason
			end
		end
	end

	return false
end

function GolemRegistry.isTooCloseToOtherGolem(x, z, excludeId)
	for id, golem in pairs(golems) do
		if id ~= excludeId and golem.character then
			local hrp = golem.character:FindFirstChild("HumanoidRootPart") or golem.character.PrimaryPart
			if hrp then
				local dx = hrp.Position.X - x
				local dz = hrp.Position.Z - z
				local dist = math.sqrt(dx * dx + dz * dz)
				if dist < golemMinDistance then
					return true
				end
			end
		end
	end
	return false
end

function GolemRegistry.canPlaceAt(x, z)
	-- Check restricted zones
	local inZone, reason = GolemRegistry.isInRestrictedZone(x, z)
	if inZone then
		return false, "Cannot build here: " .. (reason or "restricted area")
	end

	-- Check distance from other golems
	if GolemRegistry.isTooCloseToOtherGolem(x, z) then
		return false, "Too close to another golem"
	end

	return true
end

--============================================================================
-- GOLEM CREATION
--============================================================================

-- Maximum turrets per player
local MAX_TURRETS = 10

-- Place golem at any valid position
function GolemRegistry.tryPlaceAt(player, x, z)
	-- 1. CAP CHECK: Count how many golems this player owns
	local myTurretCount = 0
	for _, golem in pairs(golems) do
		if golem.ownerId == player.UserId then
			myTurretCount = myTurretCount + 1
		end
	end

	if myTurretCount >= MAX_TURRETS then
		return false, "Max turrets reached (" .. MAX_TURRETS .. ")"
	end

	-- 2. Validate placement position
	local canPlace, reason = GolemRegistry.canPlaceAt(x, z)
	if not canPlace then
		return false, reason
	end

	-- 3. Check player has enough scrap
	if WaveManager then
		local scrap = WaveManager.getScrap(player.UserId)
		if scrap < GolemStats.cost then
			return false, "Not enough scrap (" .. scrap .. "/" .. GolemStats.cost .. ")"
		end

		-- Deduct cost
		WaveManager.removeScrap(player.UserId, GolemStats.cost)
	end

	-- 4. Create the golem
	local golemId = GolemRegistry.create(x, z)
	if golemId then
		-- Assign a sequential number for display
		golems[golemId].spotId = nextGolemNumber
		golems[golemId].ownerId = player.UserId
		nextGolemNumber = nextGolemNumber + 1

		-- Set attribute for client lookup
		GolemRegistry.setGolemAttribute(golems[golemId])

		print("GolemRegistry: Player", player.Name, "placed golem", myTurretCount + 1, "/", MAX_TURRETS)
		GolemRegistry.broadcastState()
		return true, golemId
	end

	return false, "Failed to create golem"
end

-- Sell a golem and reclaim scraps (partial refund)
function GolemRegistry.sellGolem(player, golemId)
	local golem = golems[golemId]
	if not golem then
		return false, "Golem not found"
	end

	-- Check ownership
	if golem.ownerId ~= player.UserId then
		return false, "You don't own this golem"
	end

	-- Calculate refund (75% of cost)
	local refund = math.floor(GolemStats.cost * 0.75)

	-- Refund scrap
	if WaveManager then
		WaveManager.addScrap(player.UserId, refund)
	end

	-- Destroy the golem
	GolemRegistry.destroy(golemId)

	print("GolemRegistry: Player", player.Name, "sold golem for", refund, "scrap")
	GolemRegistry.broadcastState()

	return true, refund
end

function GolemRegistry.create(x, z)
	-- Create model
	local character = GolemRegistry.createModel(x, z)
	if not character then return nil end

	-- Create interpreter for this golem
	local interp = Interpreter.new(nil, true, deps) -- isMonster = true for tick rate
	interp.character = character
	interp.isGolem = true

	-- Golem-specific state (unified for all golems)
	interp.hp = GolemStats.hp
	interp.maxHp = GolemStats.hp
	interp.ammo = GolemStats.maxAmmo
	interp.maxAmmo = GolemStats.maxAmmo
	interp.range = GolemStats.range
	interp.lastFireTime = 0
	interp.lastAmmoType = nil -- Track last ammo type for fire rate
	interp.target = nil    -- Current target enemy ID
	interp.status = "IDLE"

	-- Load default program
	interp:load(DEFAULT_PROGRAM)
	interp.lastProgram = DEFAULT_PROGRAM

	-- Generate ID
	local id = game:GetService("HttpService"):GenerateGUID()
	interp.id = id

	-- Create golem data
	local golem = {
		id = id,
		interpreter = interp,
		character = character,
		typeData = GolemStats,
		spotId = nil,
		ownerId = nil,

		-- Visual state
		facingAngle = 0,
		targetAngle = 0,
		barrelTilt = 0,
	}

	golems[id] = golem

	-- Register with EntityRegistry
	if deps.EntityRegistry then
		deps.EntityRegistry.register({
			id = id,
			isGolem = true,
			character = character,
			hp = interp.hp,
			maxHp = interp.maxHp,
		})
	end

	-- Create billboard
	GolemRegistry.createBillboard(golem)

	print("GolemRegistry: Created golem at", x, z)
	return id
end

function GolemRegistry.createModel(x, z)
	local model = Instance.new("Model")
	model.Name = "HeavyBunkerTurret"

	-- Helper to weld parts easily
	local function weldTo(part0, part1)
		local w = Instance.new("WeldConstraint")
		w.Part0 = part0
		w.Part1 = part1
		w.Parent = part0
	end

	-- Color Palette based on image
	local armorColor = Color3.fromRGB(200, 200, 210) -- Light Grey/White Armor
	local darkColor = Color3.fromRGB(50, 50, 55)  -- Dark Grey mechanical parts
	local neonColor = Color3.fromRGB(0, 255, 255) -- Cyan for lights (optional pop)

	-- 1. ROOT (Invisible center)
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(4, 4, 4)
	root.Position = Vector3.new(x, 2, z)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.Parent = model
	model.PrimaryPart = root

	-- ==========================================
	-- 2. THE BASE (Hexagonal Skirt)
	-- ==========================================

	-- Central Pillar (Hides gaps inside the skirt)
	local basePillar = Instance.new("Part")
	basePillar.Name = "BasePillar"
	basePillar.Shape = Enum.PartType.Cylinder
	basePillar.Size = Vector3.new(3, 3.5, 3.5) -- Height, Dia, Dia (Rotated)
	basePillar.Position = Vector3.new(x, 1.5, z)
	basePillar.Orientation = Vector3.new(0, 0, 90)
	basePillar.Material = Enum.Material.Metal
	basePillar.Color = darkColor
	basePillar.Anchored = true
	basePillar.Parent = model

	-- The 6 Armor Plates (Wedges)
	for i = 0, 5 do
		local angle = math.rad(i * 60)
		local radius = 2.2 -- How far out the plates sit

		local wedge = Instance.new("WedgePart")
		wedge.Name = "ArmorSkirt"
		wedge.Size = Vector3.new(2, 2.5, 2) -- Width, Height, Thickness
		wedge.Material = Enum.Material.Metal
		wedge.Color = armorColor
		wedge.Anchored = true
		wedge.CanCollide = true -- The base can be solid

		-- Position: Center + Offset
		local offset = Vector3.new(math.sin(angle) * radius, 1.25, math.cos(angle) * radius)
		local pos = Vector3.new(x, 0, z) + offset

		-- Orientation: Look at center, then flip so slope faces outward
		wedge.CFrame = CFrame.lookAt(pos, Vector3.new(x, 0, z))
		wedge.Parent = model

		-- Add the "Vent" detail between plates (from image)
		local vent = Instance.new("Part")
		vent.Size = Vector3.new(0.5, 1.5, 0.2)
		vent.Color = darkColor
		vent.Material = Enum.Material.Neon                -- Make it glow slightly
		vent.Anchored = true
		vent.CFrame = wedge.CFrame * CFrame.new(1.1, -0.5, 0.5) -- Position in the gap
		vent.Parent = model
	end

	-- ==========================================
	-- 3. THE TURRET HEAD (Rotating Assembly)
	-- ==========================================

	-- Main Rotating Block (The "Head")
	local head = Instance.new("Part")
	head.Name = "Head" -- SCRIPT LOOKS FOR THIS NAME
	head.Size = Vector3.new(2.5, 2.5, 3)
	head.Position = Vector3.new(x, 3.5, z)
	head.Anchored = true
	head.CanCollide = false
	head.Material = Enum.Material.Metal
	head.Color = armorColor
	head.Parent = model

	-- Detail: Top Hatch
	local hatch = Instance.new("Part")
	hatch.Size = Vector3.new(1.5, 0.2, 1.5)
	hatch.Color = darkColor
	hatch.CFrame = head.CFrame * CFrame.new(0, 1.3, 0)
	hatch.Anchored = false -- Must be unanchored for weld to work
	hatch.CanCollide = false
	hatch.Parent = model
	weldTo(head, hatch)

	-- Detail: Side "Ears" (The large cylinders on the sides)
	for _, side in ipairs({ -1, 1 }) do
		local ear = Instance.new("Part")
		ear.Shape = Enum.PartType.Cylinder
		ear.Size = Vector3.new(1, 2.5, 2.5) -- Height (X axis relative), Dia, Dia
		ear.Color = armorColor
		ear.Material = Enum.Material.Metal
		ear.Anchored = false -- Must be unanchored for weld to work
		ear.CanCollide = false
		-- Rotate cylinder so flat side faces out (Z axis rotation)
		ear.CFrame = head.CFrame * CFrame.new(side * 1.5, 0, 0) * CFrame.Angles(0, 0, math.rad(90))
		ear.Parent = model
		weldTo(head, ear)

		-- Inner darker circle on the ear
		local earCap = Instance.new("Part")
		earCap.Shape = Enum.PartType.Cylinder
		earCap.Size = Vector3.new(1.1, 1.5, 1.5)
		earCap.Color = darkColor
		earCap.Material = Enum.Material.Metal
		earCap.Anchored = false -- Must be unanchored for weld to work
		earCap.CanCollide = false
		earCap.CFrame = head.CFrame * CFrame.new(side * 1.5, 0, 0) * CFrame.Angles(0, 0, math.rad(90))
		earCap.Parent = model
		weldTo(head, earCap)
	end

	-- ==========================================
	-- 4. THE BARREL (Gun Assembly)
	-- ==========================================

	-- Gun Mantlet (The boxy part connecting barrel to head)
	local mantlet = Instance.new("Part")
	mantlet.Size = Vector3.new(1.2, 1.2, 1.5)
	mantlet.Color = darkColor
	mantlet.Material = Enum.Material.DiamondPlate
	mantlet.Anchored = false                         -- Must be unanchored for weld to work
	mantlet.CanCollide = false
	mantlet.CFrame = head.CFrame * CFrame.new(0, 0, -2) -- Stick out front
	mantlet.Parent = model
	weldTo(head, mantlet)                            -- Weld to head so it rotates

	-- The Main Barrel
	local barrel = Instance.new("Part")
	barrel.Name = "Barrel"              -- SCRIPT LOOKS FOR THIS NAME
	barrel.Shape = Enum.PartType.Cylinder
	barrel.Size = Vector3.new(3, 0.8, 0.8) -- Height (Length), Dia, Dia (Rotated)
	barrel.Color = armorColor           -- White barrel like image
	barrel.Material = Enum.Material.Metal
	barrel.Anchored = false             -- Must be unanchored for weld to work
	barrel.CanCollide = false
	-- Cylinder default orientation is sideways, rotate to point forward
	barrel.CFrame = mantlet.CFrame * CFrame.new(0, 0, -2) * CFrame.Angles(0, math.rad(90), 0)
	barrel.Parent = model
	weldTo(head, barrel)

	-- Muzzle Brake (The tip)
	local tip = Instance.new("Part")
	tip.Name = "Tip"                 -- Used for muzzle flash origin
	tip.Shape = Enum.PartType.Cylinder
	tip.Size = Vector3.new(1, 1.2, 1.2) -- Slightly fatter than barrel
	tip.Color = darkColor
	tip.Material = Enum.Material.Metal
	tip.Anchored = false                          -- Must be unanchored for weld to work
	tip.CanCollide = false
	tip.CFrame = barrel.CFrame * CFrame.new(2, 0, 0) -- Relative to barrel cylinder (X is length)
	tip.Parent = model
	weldTo(head, tip)

	-- Detail: Dark ring inside barrel (fake hole)
	local hole = Instance.new("Part")
	hole.Shape = Enum.PartType.Cylinder
	hole.Size = Vector3.new(0.1, 0.6, 0.6)
	hole.Color = Color3.new(0, 0, 0)
	hole.Anchored = false -- Must be unanchored for weld to work
	hole.CanCollide = false
	hole.CFrame = tip.CFrame * CFrame.new(0.5, 0, 0)
	hole.Parent = model
	weldTo(head, hole)

	-- Position and parent
	model.Parent = workspace

	return model
end

-- Set GolemId attribute after creation (called from create())
function GolemRegistry.setGolemAttribute(golem)
	if golem and golem.character then
		golem.character:SetAttribute("GolemId", golem.id)
		golem.character:SetAttribute("SpotId", golem.spotId)
	end
end

function GolemRegistry.createBillboard(golem)
	local character = golem.character
	local hrp = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
	if not hrp then return end

	-- Billboard GUI
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "GolemBillboard"
	billboard.Size = UDim2.new(0, 120, 0, 60)
	billboard.StudsOffset = Vector3.new(0, 5, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = hrp

	-- Background
	local bg = Instance.new("Frame")
	bg.Name = "Background"
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
	bg.BackgroundTransparency = 0.3
	bg.BorderSizePixel = 0
	bg.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = bg

	-- ID Label (big, prominent)
	local idLabel = Instance.new("TextLabel")
	idLabel.Name = "IdLabel"
	idLabel.Size = UDim2.new(0.3, 0, 0.5, 0)
	idLabel.Position = UDim2.new(0, 4, 0, 2)
	idLabel.BackgroundTransparency = 1
	idLabel.Text = "#" .. (golem.spotId or "?")
	idLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	idLabel.Font = Enum.Font.GothamBold
	idLabel.TextSize = 18
	idLabel.TextXAlignment = Enum.TextXAlignment.Left
	idLabel.Parent = bg

	-- Status Label
	local statusLabel = Instance.new("TextLabel")
	statusLabel.Name = "StatusLabel"
	statusLabel.Size = UDim2.new(0.6, 0, 0.3, 0)
	statusLabel.Position = UDim2.new(0.35, 0, 0.05, 0)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Text = "IDLE"
	statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
	statusLabel.Font = Enum.Font.Code
	statusLabel.TextSize = 10
	statusLabel.TextXAlignment = Enum.TextXAlignment.Right
	statusLabel.Parent = bg

	-- Power Bar (based on range - lower range = more power)
	local powerBg = Instance.new("Frame")
	powerBg.Name = "PowerBarBg"
	powerBg.Size = UDim2.new(0.9, 0, 0.15, 0)
	powerBg.Position = UDim2.new(0.05, 0, 0.4, 0)
	powerBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	powerBg.BorderSizePixel = 0
	powerBg.Parent = bg

	local powerBar = Instance.new("Frame")
	powerBar.Name = "PowerBar"
	powerBar.Size = UDim2.new(1, 0, 1, 0)
	powerBar.BackgroundColor3 = Color3.fromRGB(255, 150, 50)
	powerBar.BorderSizePixel = 0
	powerBar.Parent = powerBg

	-- Ammo Bar
	local ammoBg = Instance.new("Frame")
	ammoBg.Name = "AmmoBarBg"
	ammoBg.Size = UDim2.new(0.9, 0, 0.15, 0)
	ammoBg.Position = UDim2.new(0.05, 0, 0.6, 0)
	ammoBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	ammoBg.BorderSizePixel = 0
	ammoBg.Parent = bg

	local ammoBar = Instance.new("Frame")
	ammoBar.Name = "AmmoBar"
	ammoBar.Size = UDim2.new(1, 0, 1, 0)
	ammoBar.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
	ammoBar.BorderSizePixel = 0
	ammoBar.Parent = ammoBg

	-- Power/Range label (shows multiplier and range)
	local powerLabel = Instance.new("TextLabel")
	powerLabel.Name = "PowerLabel"
	powerLabel.Size = UDim2.new(1, 0, 0.2, 0)
	powerLabel.Position = UDim2.new(0, 0, 0.78, 0)
	powerLabel.BackgroundTransparency = 1
	powerLabel.Text = "1.0x @ 40"
	powerLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
	powerLabel.Font = Enum.Font.Code
	powerLabel.TextSize = 9
	powerLabel.Parent = bg

	golem.billboard = billboard
end

--============================================================================
-- UPDATE LOOP
--============================================================================

function GolemRegistry.update(dt)
	for id, golem in pairs(golems) do
		local interp = golem.interpreter
		local character = golem.character

		if not character or not character.Parent then
			continue
		end

		-- Dead?
		if interp.hp <= 0 then
			GolemRegistry.destroy(id)
			continue
		end

		-- Only run interpreter if not paused
		if not interp.paused then
			-- Auto-restart looping programs when done (but NOT when error - let error show!)
			if interp.status == "DONE" then
				interp:reset()
				-- Re-load the program to restart
				if interp.lastProgram then
					interp:load(interp.lastProgram)
				end
			end
			-- Don't auto-restart on ERROR - let user see the error on billboard

			-- Golems run at their own tick rate
			golem.tickAccum = (golem.tickAccum or 0) + dt
			if golem.tickAccum >= (deps.Config.GOLEM_TICK_RATE or 0.1) then
				golem.tickAccum = 0
				if interp.status == "READY" or interp.status == "RUNNING" then
					local freeSteps = deps.Config.GOLEM_FREE_STEPS_PER_TICK or 8
					interp:run(deps.Config.GOLEM_TICKS_PER_UPDATE or 1, freeSteps)
				end
			end
		end

		-- Update visual aiming
		if interp.target and EnemyManager then
			local enemy = EnemyManager.get(interp.target)
			if enemy and enemy.character then
				local enemyHrp = enemy.character:FindFirstChild("HumanoidRootPart")
				local myHrp = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
				if enemyHrp and myHrp then
					local dx = enemyHrp.Position.X - myHrp.Position.X
					local dz = enemyHrp.Position.Z - myHrp.Position.Z
					golem.targetAngle = math.atan2(dx, dz) + math.pi
				end
			end
		end

		-- Smooth rotation toward target
		local angleDiff = golem.targetAngle - golem.facingAngle
		while angleDiff > math.pi do angleDiff = angleDiff - 2 * math.pi end
		while angleDiff < -math.pi do angleDiff = angleDiff + 2 * math.pi end
		golem.facingAngle = golem.facingAngle + angleDiff * 0.15

		-- Update head rotation (welded parts follow automatically)
		local head = character:FindFirstChild("Head")
		if head then
			local hrp = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
			if hrp then
				-- Set head CFrame - all welded parts (ears, mantlet, barrel, tip) follow
				head.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 1.5, 0)) *
					CFrame.Angles(0, golem.facingAngle, 0)
			end
		end

		-- Update billboard
		GolemRegistry.updateBillboard(golem)
	end
end

function GolemRegistry.updateBillboard(golem)
	local billboard = golem.billboard
	if not billboard then return end

	local interp = golem.interpreter
	local bg = billboard:FindFirstChild("Background")
	if not bg then return end

	-- Update ID
	local idLabel = bg:FindFirstChild("IdLabel")
	if idLabel then
		idLabel.Text = "#" .. (golem.spotId or "?")
	end

	-- Update status
	local statusLabel = bg:FindFirstChild("StatusLabel")
	if statusLabel then
		if interp.error and interp.error ~= "" then
			-- Show error message (truncate to 25 chars)
			local errorMsg = interp.error:sub(1, 25)
			statusLabel.Text = "ERR: " .. errorMsg
			statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		elseif interp.status == "RUNNING" then
			statusLabel.Text = "RUNNING"
			statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
		elseif interp.ammo <= 0 then
			statusLabel.Text = "EMPTY"
			statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		elseif interp.target then
			statusLabel.Text = "FIRING"
			statusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
		else
			statusLabel.Text = "IDLE"
			statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		end
	end

	-- Update Power bar (based on dynamicRange)
	-- Range 10 = 4x power, Range 40 = 1x power, Range 60 = 0.66x power
	local powerBarBg = bg:FindFirstChild("PowerBarBg")
	if powerBarBg then
		local powerBar = powerBarBg:FindFirstChild("PowerBar")
		if powerBar then
			local currentRange = interp.dynamicRange or 40
			local powerMultiplier = 40 / currentRange
			-- Normalize to bar: 0.66x = 0.165, 1x = 0.25, 4x = 1.0
			-- Map range 10-60 to bar 1.0-0.166
			local barRatio = math.clamp((60 - currentRange) / 50, 0, 1)
			powerBar.Size = UDim2.new(barRatio, 0, 1, 0)

			-- Color based on power level
			if powerMultiplier >= 2 then
				powerBar.BackgroundColor3 = Color3.fromRGB(255, 100, 100) -- Red = High damage
			elseif powerMultiplier >= 1 then
				powerBar.BackgroundColor3 = Color3.fromRGB(255, 200, 100) -- Orange = Normal
			else
				powerBar.BackgroundColor3 = Color3.fromRGB(100, 200, 255) -- Blue = Long range
			end
		end
	end

	-- Update Ammo bar
	local ammoBarBg = bg:FindFirstChild("AmmoBarBg")
	if ammoBarBg then
		local ammoBar = ammoBarBg:FindFirstChild("AmmoBar")
		if ammoBar then
			local ratio = interp.ammo / interp.maxAmmo
			ammoBar.Size = UDim2.new(ratio, 0, 1, 0)
			if ratio > 0.3 then
				ammoBar.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
			else
				ammoBar.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
			end
		end
	end

	-- Update power label (shows multiplier and range)
	local powerLabel = bg:FindFirstChild("PowerLabel")
	if powerLabel then
		local currentRange = interp.dynamicRange or 40
		local powerMultiplier = 40 / currentRange
		powerLabel.Text = string.format("%.1fx @ %d", powerMultiplier, currentRange)
	end
end

--============================================================================
-- GOLEM ACTIONS (called by GolemWords)
--============================================================================

function GolemRegistry.fire(golemId, ammoType, skipCooldown)
	local golem = golems[golemId]
	if not golem then return false end

	-- Get ammo stats (default to BULLET if invalid)
	local ammoStats = AmmoStats[ammoType] or AmmoStats[1]

	local interp = golem.interpreter

	-- 1. Determine Range and Damage Multiplier
	-- Math:
	-- 10 Range = 4.0x Damage (Shotgun)
	-- 40 Range = 1.0x Damage (Standard)
	-- 60 Range = 0.66x Damage (Sniper)
	local baseRange = 40 -- Standard range
	local currentRange = interp.dynamicRange or baseRange
	local damageMult = baseRange / currentRange

	-- Check if enough ammo
	if interp.ammo < ammoStats.ammoCost then
		return false
	end

	-- Check fire rate (per ammo type) - skip for burst fire (2FIRE, 3FIRE)
	local now = tick()
	if not skipCooldown and now - interp.lastFireTime < ammoStats.fireRate then
		return false
	end

	-- Check target is valid
	if not interp.target then
		return false
	end

	if not EnemyManager then
		return false
	end

	local enemy = EnemyManager.get(interp.target)
	if not enemy or enemy.hp <= 0 then
		interp.target = nil
		return false
	end

	-- Check Actual Distance against Dynamic Range
	local character = golem.character
	local myHrp = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
	local enemyHrp = enemy.character and enemy.character:FindFirstChild("HumanoidRootPart")
	if not myHrp or not enemyHrp then
		return false
	end

	local dist = (enemyHrp.Position - myHrp.Position).Magnitude

	if dist > currentRange then
		interp.target = nil
		return false
	end

	-- Fire! Consume ammo
	interp.ammo = interp.ammo - ammoStats.ammoCost
	interp.lastFireTime = now

	-- Calculate Final Damage
	local finalDamage = math.floor(ammoStats.damage * damageMult)

	-- Deal damage (splash for rockets)
	if ammoStats.splashRadius and ammoStats.splashRadius > 0 then
		-- AOE damage for rockets
		local enemies = EnemyManager.getAll and EnemyManager.getAll() or {}
		for _, e in pairs(enemies) do
			if e.hp > 0 and e.character then
				local eHrp = e.character:FindFirstChild("HumanoidRootPart")
				if eHrp then
					local eDist = (eHrp.Position - enemyHrp.Position).Magnitude
					if eDist <= ammoStats.splashRadius then
						-- Damage falls off with distance
						local falloff = 1 - (eDist / ammoStats.splashRadius) * 0.5
						EnemyManager.damage(e.id, math.floor(finalDamage * falloff), golemId)
					end
				end
			end
		end
	else
		-- Single target damage
		if finalDamage > 0 then
			EnemyManager.damage(interp.target, finalDamage, golemId)
		end
	end

	-- Apply slow effect for ICE/FREEZE ammo
	if ammoStats.slowAmount and ammoStats.slowDuration then
		EnemyManager.applySlow(interp.target, ammoStats.slowAmount, ammoStats.slowDuration)
	end

	-- Visual effect
	GolemRegistry.createMuzzleFlash(golem, enemyHrp.Position, ammoStats)

	return true
end

function GolemRegistry.createMuzzleFlash(golem, targetPos, ammoStats)
	local character = golem.character
	local barrel = character:FindFirstChild("Barrel")
	-- If we have a dedicated tip, use that as origin
	local tip = character:FindFirstChild("Tip")
	local origin = tip and tip.Position or (barrel and barrel.Position) or character.PrimaryPart.Position
	local color = ammoStats and ammoStats.color or Color3.fromRGB(255, 255, 200)

	-- 1. Flash - expanding ball
	task.spawn(function()
		local flash = Instance.new("Part")
		flash.Shape = Enum.PartType.Ball
		flash.Size = Vector3.new(1, 1, 1)
		flash.Position = origin
		flash.Anchored = true
		flash.CanCollide = false
		flash.Material = Enum.Material.Neon
		flash.Color = color
		flash.Transparency = 0.2
		flash.Parent = workspace

		-- Expand and fade
		local tween = TweenService:Create(flash, TweenInfo.new(0.1), { Size = Vector3.new(3, 3, 3), Transparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		flash:Destroy()
	end)

	-- 2. Beam/Tracer
	local dist = (targetPos - origin).Magnitude

	local beamPart = Instance.new("Part")
	beamPart.Name = "LaserBeam"
	beamPart.Anchored = true
	beamPart.CanCollide = false
	beamPart.Material = Enum.Material.Neon
	beamPart.Color = color
	beamPart.Size = Vector3.new(0.2, 0.2, dist)
	beamPart.CFrame = CFrame.lookAt(origin, targetPos) * CFrame.new(0, 0, -dist / 2)
	beamPart.Parent = workspace

	-- Rockets are thicker and have explosion
	if ammoStats and ammoStats.splashRadius then
		beamPart.Size = Vector3.new(0.4, 0.4, dist)

		task.spawn(function()
			task.wait(0.05)
			beamPart:Destroy()

			-- Explosion
			local explosion = Instance.new("Part")
			explosion.Name = "Explosion"
			explosion.Shape = Enum.PartType.Ball
			explosion.Size = Vector3.new(2, 2, 2)
			explosion.Position = targetPos
			explosion.Anchored = true
			explosion.CanCollide = false
			explosion.Material = Enum.Material.Neon
			explosion.Color = color
			explosion.Parent = workspace

			-- Tween explosion expand and fade
			local explodeTween = TweenService:Create(explosion, TweenInfo.new(0.15), {
				Size = Vector3.new(12, 12, 12),
				Transparency = 1,
			})
			explodeTween:Play()
			explodeTween.Completed:Wait()
			explosion:Destroy()
		end)
	else
		-- Beam fade out
		local tween = TweenService:Create(beamPart, TweenInfo.new(0.15),
			{ Transparency = 1, Size = Vector3.new(0, 0, dist) })
		tween:Play()
		task.delay(0.15, function()
			beamPart:Destroy()
		end)
	end
end

--============================================================================
-- PROGRAM MANAGEMENT
--============================================================================

function GolemRegistry.uploadProgram(golemId, source, autoStart)
	local golem = golems[golemId]
	if not golem then return false, "Golem not found" end

	local interp = golem.interpreter
	local success = interp:load(source)

	if success then
		-- Start program immediately if autoStart is true (default behavior)
		if autoStart ~= false then
			interp.paused = false
		end
		print("GolemRegistry: Uploaded new program to golem", golemId)
		return true
	else
		return false, interp.error or "Compilation failed"
	end
end

function GolemRegistry.getProgram(golemId)
	local golem = golems[golemId]
	if not golem then return nil end

	-- Return the source code (tokens joined)
	return table.concat(golem.interpreter.tokens or {}, " ")
end

--============================================================================
-- QUERIES
--============================================================================

function GolemRegistry.get(id)
	return golems[id]
end

function GolemRegistry.getInterpreter(id)
	local golem = golems[id]
	return golem and golem.interpreter
end

function GolemRegistry.getAll()
	return golems
end

function GolemRegistry.count()
	local n = 0
	for _ in pairs(golems) do n = n + 1 end
	return n
end

function GolemRegistry.getBySpotId(spotId)
	for id, golem in pairs(golems) do
		if golem.spotId == spotId then
			return golem
		end
	end
	return nil
end

function GolemRegistry.findNearest(x, z, maxRange)
	local nearest = nil
	local nearestDist = maxRange or math.huge

	for id, golem in pairs(golems) do
		local character = golem.character
		local hrp = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
		if hrp then
			local dx = hrp.Position.X - x
			local dz = hrp.Position.Z - z
			local dist = math.sqrt(dx * dx + dz * dz)
			if dist < nearestDist then
				nearestDist = dist
				nearest = golem
			end
		end
	end

	return nearest, nearestDist
end

function GolemRegistry.findNearestToCharacter(character)
	if not character then return nil end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	return GolemRegistry.findNearest(hrp.Position.X, hrp.Position.Z, 10)
end

function GolemRegistry.refillAmmo(golemId, amount)
	local golem = golems[golemId]
	if not golem then return 0 end

	local interp = golem.interpreter
	local needed = interp.maxAmmo - interp.ammo
	local toAdd = math.min(amount, needed)

	interp.ammo = interp.ammo + toAdd
	return toAdd
end

--============================================================================
-- DESTRUCTION
--============================================================================

function GolemRegistry.destroy(id)
	local golem = golems[id]
	if not golem then return end

	-- Unregister
	if deps.EntityRegistry then
		deps.EntityRegistry.unregister(id)
	end

	-- Destroy model
	if golem.character then
		golem.character:Destroy()
	end

	golems[id] = nil
	print("GolemRegistry: Destroyed golem", id)
end

function GolemRegistry.clear()
	for id in pairs(golems) do
		GolemRegistry.destroy(id)
	end

	-- Reset golem counter
	nextGolemNumber = 1
end

--============================================================================
-- ZONE VISUALIZATION
--============================================================================

function GolemRegistry.createZoneVisuals()
	if not mapData then return end

	-- Clear existing visuals
	local existingFolder = workspace:FindFirstChild("ZoneVisuals")
	if existingFolder then
		existingFolder:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = "ZoneVisuals"
	folder.Parent = workspace

	local pathMaterial = Enum.Material.ForceField
	-- local pathColor = Color3.fromRGB(255, 100, 100)  -- Red tint for paths
	local pathColor = Color3.fromRGB(50, 200, 255)
	local pathTransparency = 0.85

	for i, zone in ipairs(restrictedZones) do
		if zone.type == "circle" and zone.reason ~= "boundary" then
			local part = Instance.new("Part")
			part.Name = "Zone_" .. i .. "_" .. zone.reason
			part.Shape = Enum.PartType.Cylinder
			part.Size = Vector3.new(0.5, zone.radius * 2, zone.radius * 2)
			part.Position = Vector3.new(zone.x, 0.3, zone.z)
			part.Orientation = Vector3.new(0, 0, 90)
			part.Anchored = true
			part.CanCollide = false
			part.Material = pathMaterial
			part.Color = zone.reason == "core" and Color3.fromRGB(100, 200, 255) or pathColor
			part.Transparency = pathTransparency
			part.Parent = folder
		elseif zone.type == "rect" then
			local width = zone.x2 - zone.x1
			local depth = zone.z2 - zone.z1
			local part = Instance.new("Part")
			part.Name = "Zone_" .. i .. "_" .. zone.reason
			part.Size = Vector3.new(width, 0.5, depth)
			part.Position = Vector3.new(zone.x1 + width / 2, 0.3, zone.z1 + depth / 2)
			part.Anchored = true
			part.CanCollide = false
			part.Material = pathMaterial
			part.Color = pathColor
			part.Transparency = pathTransparency
			part.Parent = folder
		elseif zone.type == "line" then
			-- Create a series of parts along the line
			local dx = zone.x2 - zone.x1
			local dz = zone.z2 - zone.z1
			local length = math.sqrt(dx * dx + dz * dz)
			local angle = math.atan2(dx, dz)

			local part = Instance.new("Part")
			part.Name = "Zone_" .. i .. "_" .. zone.reason
			part.Size = Vector3.new(zone.width, 0.5, length)
			part.Position = Vector3.new((zone.x1 + zone.x2) / 2, 0.3, (zone.z1 + zone.z2) / 2)
			part.Orientation = Vector3.new(0, math.deg(angle), 0)
			part.Anchored = true
			part.CanCollide = false
			part.Material = pathMaterial
			part.Color = pathColor
			part.Transparency = pathTransparency
			part.Parent = folder
		end
	end

	print("GolemRegistry: Created zone visuals")
end

--============================================================================
-- STATE BROADCAST
--============================================================================

function GolemRegistry.broadcastState()
	local golemList = {}
	for id, golem in pairs(golems) do
		local interp = golem.interpreter
		table.insert(golemList, {
			id = id,
			spotId = golem.spotId,
			typeName = golem.typeData.name,
			hp = interp.hp,
			maxHp = interp.maxHp,
			ammo = interp.ammo,
			maxAmmo = interp.maxAmmo,
			dynamicRange = interp.dynamicRange or 40,
			status = interp.ammo <= 0 and "EMPTY" or (interp.target and "FIRING" or "IDLE"),
		})
	end

	local data = {
		golems = golemList,
	}

	for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
		golemStateEvent:FireClient(player, data)
	end
end

function GolemRegistry.sendGolemFullState(golemId, player)
	local golem = golems[golemId]
	if not golem or not golem.interpreter then return end

	local state = golem.interpreter:getState()
	state.golemId = golemId
	state.spotId = golem.spotId
	state.typeName = golem.typeData.name
	state.programSource = table.concat(golem.interpreter.tokens or {}, " ")

	golemFullStateEvent:FireClient(player, state)
end

function GolemRegistry.getGolemStats()
	return GolemStats
end

--============================================================================
-- UPDATE HEARTBEAT
--============================================================================

function GolemRegistry.startUpdateLoop()
	RunService.Heartbeat:Connect(function(dt)
		GolemRegistry.update(dt)
		-- Note: Full interpreter state is now sent by main.server based on playerViewingGolem
	end)
end

return GolemRegistry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">WaveManager</string>
          <string name="Source"><![CDATA[-- WaveManager.luau
-- Core game loop for Tower Defense mode
-- Manages waves, Core HP, game phases, and scrap economy

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local WaveManager = {}

-- Dependencies (set via init)
local deps = nil
local EnemyManager = nil
local GolemRegistry = nil

-- Game state
local state = {
	phase = "LOBBY", -- LOBBY, BUILD, COMBAT, UPGRADE, GAMEOVER, VICTORY
	waveNumber = 0,
	totalWaves = 0, -- Infinite waves now (NG+ after wave 8)

	-- Core (the thing we're defending)
	coreHp = 1000,
	coreMaxHp = 1000,
	corePosition = nil, -- Set from map
	coreModel = nil,

	-- Economy
	scrap = {}, -- { [userId] = amount }

	-- Timing
	buildTime = 30,     -- Seconds for build phase
	buildTimeRemaining = 0,
	waveSpawnInterval = 2, -- Seconds between enemy spawns in wave

	-- Wave tracking
	enemiesRemaining = 0,
	enemiesSpawned = 0,
	enemiesToSpawn = 0,
	spawnQueue = {}, -- { {type, gate, delay}, ... }

	-- Ready system (for lobby)
	readyPlayers = {},

	-- New Game+ tracking
	ngPlusLevel = 0, -- Each level doubles enemy HP
	highestGateUnlocked = 1,

	-- Restart countdown
	restartTimeRemaining = 0,
}

-- Remote events
local coreHitEvent = nil
local playerReadyEvent = nil
local skipBuildEvent = nil
local waveRewardEvent = nil

-- Wave definitions - each wave unlocks a new gate
-- Waves 1-8 progressively unlock all 8 gates
-- After wave 8, enemies get NG+ scaling (double HP) and waves loop
local WaveDefinitions = {
	[1] = { -- Gate 1 only (North)
		{ type = "Zombie", count = 6, gate = 1, interval = 2.5 },
	},
	[2] = { -- Gate 2 unlocks (South)
		{ type = "Zombie", count = 8, gate = 1, interval = 2 },
		{ type = "Zombie", count = 5, gate = 2, interval = 2.5 },
	},
	[3] = { -- Gate 3 unlocks (West) + 2FIRE unlocked!
		{ type = "Zombie", count = 10, gate = 1, interval = 1.8 },
		{ type = "Runner", count = 6,  gate = 2, interval = 2 },
		{ type = "Zombie", count = 5,  gate = 3, interval = 2.5 },
	},
	[4] = { -- Gate 4 unlocks (East)
		{ type = "Zombie", count = 12, gate = 1, interval = 1.5 },
		{ type = "Runner", count = 8,  gate = 2, interval = 1.5 },
		{ type = "Tank",   count = 2,  gate = 3, interval = 4 },
		{ type = "Zombie", count = 6,  gate = 4, interval = 2 },
	},
	[5] = { -- Gate 5 unlocks (NorthWest diagonal) + First Boss!
		{ type = "Tank",   count = 4,  gate = 1, interval = 4 },
		{ type = "Zombie", count = 15, gate = 2, interval = 1 },
		{ type = "Runner", count = 10, gate = 3, interval = 1 },
		{ type = "Zombie", count = 8,  gate = 4, interval = 1.5 },
		{ type = "Runner", count = 5,  gate = 5, interval = 2 },
		{ type = "Boss",   count = 1,  gate = 1, interval = 1 },
	},
	[6] = { -- Gate 6 unlocks (NorthEast diagonal) + 3FIRE unlocked!
		{ type = "Zombie", count = 15, gate = 1, interval = 0.8 },
		{ type = "Runner", count = 12, gate = 2, interval = 0.8 },
		{ type = "Tank",   count = 5,  gate = 3, interval = 3 },
		{ type = "Zombie", count = 10, gate = 4, interval = 1 },
		{ type = "Runner", count = 8,  gate = 5, interval = 1.5 },
		{ type = "Zombie", count = 6,  gate = 6, interval = 2 },
		{ type = "Boss",   count = 1,  gate = 2, interval = 1 },
	},
	[7] = { -- Gate 7 unlocks (SouthWest diagonal) - Double Boss!
		{ type = "Tank",   count = 6,  gate = 1, interval = 3 },
		{ type = "Runner", count = 15, gate = 2, interval = 0.6 },
		{ type = "Zombie", count = 12, gate = 3, interval = 1 },
		{ type = "Tank",   count = 3,  gate = 4, interval = 4 },
		{ type = "Zombie", count = 10, gate = 5, interval = 1.2 },
		{ type = "Runner", count = 8,  gate = 6, interval = 1.5 },
		{ type = "Zombie", count = 6,  gate = 7, interval = 2 },
		{ type = "Boss",   count = 1,  gate = 1, interval = 1 },
		{ type = "Boss",   count = 1,  gate = 3, interval = 1 },
	},
	[8] = { -- Gate 8 unlocks (SouthEast diagonal) - ALL GATES OPEN! Triple Boss!
		{ type = "Zombie", count = 15, gate = 1, interval = 0.8 },
		{ type = "Runner", count = 12, gate = 2, interval = 0.8 },
		{ type = "Tank",   count = 5,  gate = 3, interval = 2.5 },
		{ type = "Zombie", count = 10, gate = 4, interval = 1 },
		{ type = "Runner", count = 10, gate = 5, interval = 1 },
		{ type = "Tank",   count = 3,  gate = 6, interval = 3 },
		{ type = "Zombie", count = 8,  gate = 7, interval = 1.2 },
		{ type = "Runner", count = 6,  gate = 8, interval = 1.5 },
		{ type = "Boss",   count = 1,  gate = 1, interval = 1 },
		{ type = "Boss",   count = 1,  gate = 4, interval = 1 },
		{ type = "Boss",   count = 1,  gate = 7, interval = 1 },
	},
}

-- Rewards unlocked at each wave
-- Note: SET-RANGE and BULLET are available from the start
local WaveRewards = {
	[2] = { word = "ROCKET", message = "ROCKET - Explosive AOE damage!" },
	[3] = { word = "2FIRE", message = "2FIRE - Fire two shots at once!" },
	[4] = { word = "FREEZE", message = "FREEZE - Slows enemies (No Damage)" },
	[5] = { word = "LASER", message = "LASER - Rapid fire beam weapon!" },
	[6] = { word = "3FIRE", message = "3FIRE - Fire three shots at once!" },
	[10] = { word = "4FIRE", message = "4FIRE - Fire four shots at once!" },
	[15] = { word = "UPGRADE-AMMO-CAPACITY", message = "UPGRADE-AMMO-CAPACITY - Increase max ammo to 600!" },
	[20] = { word = "5FIRE", message = "5FIRE - Fire FIVE shots at once!" },
	[25] = { word = "MAX-AMMO-CAPACITY", message = "MAX-AMMO-CAPACITY - Increase max ammo to 900!" },
}

--============================================================================
-- INITIALIZATION
--============================================================================

function WaveManager.init(dependencies)
	deps = dependencies

	-- Create remote events
	local Forthy = ReplicatedStorage:WaitForChild("Forthy")

	coreHitEvent = Instance.new("RemoteEvent")
	coreHitEvent.Name = "CoreHit"
	coreHitEvent.Parent = Forthy

	playerReadyEvent = Instance.new("RemoteEvent")
	playerReadyEvent.Name = "PlayerReady"
	playerReadyEvent.Parent = Forthy

	skipBuildEvent = Instance.new("RemoteEvent")
	skipBuildEvent.Name = "SkipBuild"
	skipBuildEvent.Parent = Forthy

	waveRewardEvent = Instance.new("RemoteEvent")
	waveRewardEvent.Name = "WaveReward"
	waveRewardEvent.Parent = Forthy

	-- Handle player ready
	playerReadyEvent.OnServerEvent:Connect(function(player)
		WaveManager.playerReady(player.UserId)
	end)

	-- Handle skip build phase
	skipBuildEvent.OnServerEvent:Connect(function(player)
		WaveManager.skipBuildPhase()
	end)

	-- Initialize scrap for existing players
	for _, player in ipairs(Players:GetPlayers()) do
		state.scrap[player.UserId] = deps.Config.STARTING_SCRAP or 200
	end

	-- Handle new players
	Players.PlayerAdded:Connect(function(player)
		state.scrap[player.UserId] = deps.Config.STARTING_SCRAP or 200
	end)

	Players.PlayerRemoving:Connect(function(player)
		state.scrap[player.UserId] = nil
		state.readyPlayers[player.UserId] = nil
	end)

	print("WaveManager: Initialized")
end

function WaveManager.setEnemyManager(enemyMgr)
	EnemyManager = enemyMgr
end

function WaveManager.setGolemRegistry(golemReg)
	GolemRegistry = golemReg
end

--============================================================================
-- CORE MANAGEMENT
--============================================================================

-- NEW: Helper to create fancy visual gates
function WaveManager.createGateVisuals(gates)
	local corePos = state.corePosition
	if not corePos then return end

	for i, gate in ipairs(gates) do
		local model = Instance.new("Model")
		model.Name = "Gate_" .. i

		-- Calculate angle to face the core
		local dx = corePos.x - gate.x
		local dz = corePos.z - gate.z
		local angleToCore = math.atan2(dx, dz)

		-- Gate position and rotation base
		local gatePos = Vector3.new(gate.x, 0, gate.z)
		local gateCFrame = CFrame.new(gatePos) * CFrame.Angles(0, angleToCore, 0)

		-- 1. The Frame (Archway)
		local frameColor = Color3.fromRGB(80, 80, 80)
		local neonColor = Color3.fromRGB(255, 50, 50) -- Enemy Red

		-- Left Pillar
		local leftPillar = Instance.new("Part")
		leftPillar.Size = Vector3.new(2, 12, 2)
		leftPillar.CFrame = gateCFrame * CFrame.new(-4, 6, 0)
		leftPillar.Anchored = true
		leftPillar.Material = Enum.Material.Metal
		leftPillar.Color = frameColor
		leftPillar.Parent = model

		local leftStripe = Instance.new("Part")
		leftStripe.Size = Vector3.new(0.5, 10, 2.1)
		leftStripe.CFrame = leftPillar.CFrame
		leftStripe.Anchored = true
		leftStripe.CanCollide = false
		leftStripe.Material = Enum.Material.Neon
		leftStripe.Color = neonColor
		leftStripe.Parent = model

		-- Right Pillar
		local rightPillar = Instance.new("Part")
		rightPillar.Size = Vector3.new(2, 12, 2)
		rightPillar.CFrame = gateCFrame * CFrame.new(4, 6, 0)
		rightPillar.Anchored = true
		rightPillar.Material = Enum.Material.Metal
		rightPillar.Color = frameColor
		rightPillar.Parent = model

		local rightStripe = Instance.new("Part")
		rightStripe.Size = Vector3.new(0.5, 10, 2.1)
		rightStripe.CFrame = rightPillar.CFrame
		rightStripe.Anchored = true
		rightStripe.CanCollide = false
		rightStripe.Material = Enum.Material.Neon
		rightStripe.Color = neonColor
		rightStripe.Parent = model

		-- Top Bar
		local top = Instance.new("Part")
		top.Size = Vector3.new(12, 2, 3)
		top.CFrame = gateCFrame * CFrame.new(0, 13, 0)
		top.Anchored = true
		top.Material = Enum.Material.Metal
		top.Color = frameColor
		top.Parent = model

		-- 2. The Portal Field (Swirling Void)
		local field = Instance.new("Part")
		field.Name = "Field"
		field.Size = Vector3.new(6, 10, 0.2)
		field.CFrame = gateCFrame * CFrame.new(0, 7, 0)
		field.Anchored = true
		field.CanCollide = false
		field.Material = Enum.Material.ForceField
		field.Color = neonColor
		field.Transparency = 0.5
		field.Parent = model

		-- Gate Text
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.new(0, 100, 0, 50)
		bb.StudsOffset = Vector3.new(0, 8, 0)
		bb.AlwaysOnTop = true
		bb.Parent = top
		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.fromScale(1, 1)
		txt.BackgroundTransparency = 1
		txt.Text = "GATE " .. i
		txt.TextColor3 = neonColor
		txt.Font = Enum.Font.SciFi
		txt.TextSize = 20
		txt.Parent = bb

		model.Parent = workspace
	end
end

-- UPDATED: createCore with animation and particles
function WaveManager.createCore(position)
	state.corePosition = position
	state.coreHp = state.coreMaxHp

	local model = Instance.new("Model")
	model.Name = "CoreModel"

	-- 1. Base Pedestal
	local base = Instance.new("Part")
	base.Name = "Base"
	base.Shape = Enum.PartType.Cylinder
	base.Size = Vector3.new(1, 12, 12) -- Cylinders are rotated, size is (height, dia, dia)
	base.Position = Vector3.new(position.x, 0.5, position.z)
	base.Orientation = Vector3.new(0, 0, 90)
	base.Anchored = true
	base.Material = Enum.Material.Metal
	base.Color = Color3.fromRGB(50, 50, 60)
	base.Parent = model

	-- 2. The Crystal (The actual Core Hitbox)
	local core = Instance.new("Part")
	core.Name = "Core"
	core.Size = Vector3.new(4, 4, 4)
	core.Position = Vector3.new(position.x, 8, position.z)
	core.Anchored = true
	core.CanCollide = true
	core.Material = Enum.Material.Neon
	core.Color = Color3.fromRGB(0, 255, 255) -- Cyan
	core.Shape = Enum.PartType.Ball
	core.Transparency = 0.2
	core.Parent = model

	-- Make it look like a Diamond
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = "rbxassetid://9756362" -- Standard Diamond Mesh
	mesh.Scale = Vector3.new(4, 8, 4)
	mesh.Parent = core


	-- 4. Particles
	local attachment = Instance.new("Attachment", core)
	local particles = Instance.new("ParticleEmitter")
	particles.Texture = "rbxassetid://243098098" -- Generic sparkle
	particles.Color = ColorSequence.new(Color3.fromRGB(0, 255, 255))
	particles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	particles.Lifetime = NumberRange.new(1, 2)
	particles.Rate = 20
	particles.Speed = NumberRange.new(2, 4)
	particles.SpreadAngle = Vector2.new(360, 360)
	particles.Parent = attachment

	-- 5. Floating Animation for Crystal
	local floatInfo = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local floatGoal = { Position = core.Position + Vector3.new(0, 1.5, 0) }
	TweenService:Create(core, floatInfo, floatGoal):Play()

	-- 6. Spin the crystal
	task.spawn(function()
		while core and core.Parent do
			core.CFrame = core.CFrame * CFrame.Angles(0, math.rad(1), 0)
			-- Color shifts based on HP
			local hpRatio = state.coreHp / state.coreMaxHp
			if hpRatio > 0.5 then
				core.Color = Color3.fromRGB(0, 255, 255)
			elseif hpRatio > 0.25 then
				core.Color = Color3.fromRGB(255, 200, 100)
			else
				core.Color = Color3.fromRGB(255, 100, 100)
			end
			task.wait(0.02)
		end
	end)

	model.Parent = workspace
	state.coreModel = core
	print("WaveManager: Fancy Core created at", position.x, position.z)
end

function WaveManager.damageCore(amount, enemyId)
	if state.phase == "GAMEOVER" then return end

	state.coreHp = math.max(0, state.coreHp - amount)

	-- Notify clients of hit
	for _, player in ipairs(Players:GetPlayers()) do
		coreHitEvent:FireClient(player, {
			damage = amount,
			currentHp = state.coreHp,
			maxHp = state.coreMaxHp,
		})
	end

	-- Check for game over
	if state.coreHp <= 0 then
		WaveManager.gameOver()
	end
end

function WaveManager.getCorePosition()
	return state.corePosition
end

function WaveManager.getCoreHp()
	return state.coreHp, state.coreMaxHp
end

--============================================================================
-- PHASE MANAGEMENT
--============================================================================

function WaveManager.setPhase(newPhase)
	local oldPhase = state.phase
	state.phase = newPhase

	print("WaveManager: Phase changed from", oldPhase, "to", newPhase)

	if newPhase == "BUILD" then
		state.buildTimeRemaining = state.buildTime
	elseif newPhase == "COMBAT" then
		WaveManager.startWave()
	end
end

function WaveManager.getPhase()
	return state.phase
end

function WaveManager.playerReady(userId)
	state.readyPlayers[userId] = true

	-- CHANGED: If ANY player presses ready, start the game.
	-- No waiting for everyone.
	WaveManager.setPhase("BUILD")
end

function WaveManager.skipBuildPhase()
	-- CHANGED: If ANY player presses skip, start combat immediately.
	if state.phase == "BUILD" then
		state.buildTimeRemaining = 0
		WaveManager.setPhase("COMBAT")
	end
end

--============================================================================
-- WAVE MANAGEMENT
--============================================================================

function WaveManager.startWave()
	state.waveNumber = state.waveNumber + 1

	-- Check for NG+ transition (after wave 8, loop back with scaled HP)
	local effectiveWave = state.waveNumber
	if state.waveNumber > 8 then
		-- Calculate NG+ level (each 8 waves = +1 NG+ level)
		state.ngPlusLevel = math.floor((state.waveNumber - 1) / 8)
		effectiveWave = ((state.waveNumber - 1) % 8) + 1

		-- Set NG+ multiplier - more aggressive scaling!
		-- Base: 2x per NG+ level, plus 10% per wave within the cycle
		local baseMultiplier = math.pow(2, state.ngPlusLevel)
		local waveBonus = 1 + (effectiveWave - 1) * 0.15 -- +15% per wave in cycle
		local ngMultiplier = baseMultiplier * waveBonus
		if EnemyManager then
			EnemyManager.setNewGamePlusMultiplier(ngMultiplier)
		end

		print("WaveManager: NG+" .. state.ngPlusLevel .. " - Wave", state.waveNumber, "(effective wave",
			effectiveWave .. ", multiplier: " .. string.format("%.1fx", ngMultiplier) .. ")")
	else
		-- Even in first cycle, add slight scaling per wave
		local earlyMultiplier = 1 + (state.waveNumber - 1) * 0.1 -- +10% per wave
		if EnemyManager then
			EnemyManager.setNewGamePlusMultiplier(earlyMultiplier)
		end
		print("WaveManager: Starting wave", state.waveNumber)
	end

	-- Update gate unlock (waves 1-8 each unlock a gate)
	if effectiveWave > state.highestGateUnlocked then
		state.highestGateUnlocked = effectiveWave
		print("WaveManager: Gate", effectiveWave, "unlocked!")
	end

	-- Tell EnemyManager what wave we're on (for scaling)
	if EnemyManager then
		EnemyManager.setWave(state.waveNumber)
	end

	-- Check for wave rewards
	local reward = WaveRewards[effectiveWave]
	if reward and state.ngPlusLevel == 0 then -- Only announce on first cycle
		print("WaveManager:", reward.message)
		-- Send to all clients
		for _, p in ipairs(Players:GetPlayers()) do
			waveRewardEvent:FireClient(p, {
				wave = effectiveWave,
				word = reward.word,
				message = reward.message,
			})
		end
	end

	-- Get wave definition (use effective wave for NG+ looping)
	local waveDef = WaveDefinitions[effectiveWave]
	if not waveDef then
		-- Generate procedural wave if no definition
		waveDef = WaveManager.generateProceduralWave(effectiveWave)
	end

	-- Build spawn queue
	state.spawnQueue = {}
	state.enemiesToSpawn = 0
	state.enemiesSpawned = 0
	state.enemiesRemaining = 0

	for _, group in ipairs(waveDef) do
		for i = 1, group.count do
			table.insert(state.spawnQueue, {
				type = group.type,
				gate = group.gate,
				delay = (i - 1) * group.interval,
			})
			state.enemiesToSpawn = state.enemiesToSpawn + 1
		end
	end

	-- Sort by delay
	table.sort(state.spawnQueue, function(a, b) return a.delay < b.delay end)

	state.waveStartTime = tick()
	state.enemiesRemaining = state.enemiesToSpawn
end

function WaveManager.generateProceduralWave(waveNum)
	-- Fallback for waves beyond definitions
	local baseCount = 10 + waveNum * 5
	return {
		{ type = "Zombie", count = baseCount,                   gate = 1, interval = 1 },
		{ type = "Runner", count = math.floor(baseCount * 0.5), gate = 2, interval = 0.8 },
		{ type = "Tank",   count = math.floor(waveNum / 2),     gate = 3, interval = 3 },
	}
end

function WaveManager.onEnemyKilled(enemyId, killerGolemId)
	state.enemiesRemaining = state.enemiesRemaining - 1

	-- Award scrap to all players (co-op!)
	local scrapAmount = deps.Config.SCRAP_PER_KILL or 10
	for _, player in ipairs(Players:GetPlayers()) do
		WaveManager.addScrap(player.UserId, scrapAmount)
	end

	-- Check if wave complete
	if state.enemiesRemaining <= 0 and state.enemiesSpawned >= state.enemiesToSpawn then
		WaveManager.waveComplete()
	end
end

function WaveManager.onEnemyReachedCore(enemyId)
	state.enemiesRemaining = state.enemiesRemaining - 1

	-- Check if wave complete
	if state.enemiesRemaining <= 0 and state.enemiesSpawned >= state.enemiesToSpawn then
		WaveManager.waveComplete()
	end
end

function WaveManager.waveComplete()
	print("WaveManager: Wave", state.waveNumber, "complete!")

	-- Bonus scrap for completing wave (scales with NG+ level)
	local bonusScrap = state.waveNumber * 50 * (1 + state.ngPlusLevel * 0.5)
	for _, player in ipairs(Players:GetPlayers()) do
		WaveManager.addScrap(player.UserId, math.floor(bonusScrap))
	end

	-- Infinite waves - always go to build phase
	WaveManager.setPhase("BUILD")
end

--============================================================================
-- ECONOMY
--============================================================================

function WaveManager.addScrap(userId, amount)
	state.scrap[userId] = (state.scrap[userId] or 0) + amount
end

function WaveManager.removeScrap(userId, amount)
	local current = state.scrap[userId] or 0
	if current >= amount then
		state.scrap[userId] = current - amount
		return true
	end
	return false
end

function WaveManager.getScrap(userId)
	return state.scrap[userId] or 0
end

--============================================================================
-- GAME END
--============================================================================

function WaveManager.gameOver()
	state.phase = "GAMEOVER"
	state.restartTimeRemaining = 10 -- 10 second countdown
	print("WaveManager: GAME OVER - Core destroyed!")
end

function WaveManager.victory()
	state.phase = "VICTORY"
	print("WaveManager: VICTORY - All waves defeated!")

	-- Restart after delay
	task.delay(15, function()
		WaveManager.restart()
	end)
end

function WaveManager.restart()
	print("WaveManager: Restarting game...")

	-- Clear enemies
	if EnemyManager then
		EnemyManager.clear()
		EnemyManager.setNewGamePlusMultiplier(1) -- Reset NG+ multiplier
	end

	-- Clear golems
	if GolemRegistry then
		GolemRegistry.clear()
	end

	-- Reset state
	state.phase = "LOBBY"
	state.waveNumber = 0
	state.coreHp = state.coreMaxHp
	state.readyPlayers = {}
	state.spawnQueue = {}
	state.enemiesRemaining = 0
	state.enemiesSpawned = 0
	state.ngPlusLevel = 0
	state.highestGateUnlocked = 1

	-- Reset scrap
	for _, player in ipairs(Players:GetPlayers()) do
		state.scrap[player.UserId] = deps.Config.STARTING_SCRAP or 200
	end
end

--============================================================================
-- UPDATE LOOP
--============================================================================

function WaveManager.update(dt)
	if state.phase == "BUILD" then
		-- Countdown build timer
		state.buildTimeRemaining = state.buildTimeRemaining - dt
		if state.buildTimeRemaining <= 0 then
			WaveManager.setPhase("COMBAT")
		end
	elseif state.phase == "COMBAT" then
		-- Process spawn queue
		local elapsed = tick() - state.waveStartTime

		while #state.spawnQueue > 0 and state.spawnQueue[1].delay <= elapsed do
			local spawn = table.remove(state.spawnQueue, 1)

			if EnemyManager then
				EnemyManager.spawn(spawn.type, spawn.gate, deps)
				state.enemiesSpawned = state.enemiesSpawned + 1
			end
		end
	elseif state.phase == "GAMEOVER" then
		-- Countdown restart timer
		local prevSecond = math.ceil(state.restartTimeRemaining)
		state.restartTimeRemaining = state.restartTimeRemaining - dt
		local newSecond = math.ceil(state.restartTimeRemaining)

		-- Broadcast once per second so client sees countdown
		if newSecond ~= prevSecond and state.restartTimeRemaining > 0 then
			WaveManager.broadcastState()
		end

		if state.restartTimeRemaining <= 0 then
			WaveManager.restart()
		end
	end
end

--============================================================================
-- STATE BROADCAST
--============================================================================

function WaveManager.broadcastState()
	local stateData = {
		phase = state.phase,
		waveNumber = state.waveNumber,
		totalWaves = 0, -- Infinite waves
		coreHp = state.coreHp,
		coreMaxHp = state.coreMaxHp,
		buildTimeRemaining = state.buildTimeRemaining,
		restartTimeRemaining = state.restartTimeRemaining,
		enemiesRemaining = state.enemiesRemaining,
		readyCount = 0,
		totalPlayers = #Players:GetPlayers(),
		ngPlusLevel = state.ngPlusLevel,
		highestGateUnlocked = state.highestGateUnlocked,
	}

	-- Count ready players
	for userId, _ in pairs(state.readyPlayers) do
		stateData.readyCount = stateData.readyCount + 1
	end

	for _, player in ipairs(Players:GetPlayers()) do
		stateData.scrap = state.scrap[player.UserId] or 0
		stateData.isReady = state.readyPlayers[player.UserId] or false
		waveStateEvent:FireClient(player, stateData)
	end
end

function WaveManager.getState()
	return state
end

return WaveManager
